# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Jupyter / Colab
.ipynb_checkpoints/
*.nbconvert.ipynb

# Environment & credentials
.env
.env.*
secrets.json
*.pem
*.key

# Model weights & large binary files
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
*.tflite
*.h5

# Experiment checkpoints & cache
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/experiment_state.json

# Processed data caches
data/processed/*
!data/processed/.gitkeep

# Friend drops (collaborator input directory)
data/friend_drops/*
!data/friend_drops/.gitkeep

# Downloaded benchmark datasets (cached locally, re-downloadable)
data/downloads/*
!data/downloads/.gitkeep

# Synthetic generated images (generated on the fly)
data/synthetic_images/*
!data/synthetic_images/.gitkeep

# Keep results CSV and figures in Git for benchmarking
!results/*.csv
!results/*.png
!results/.gitkeep

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Logs and profiling
*.log
runs/
wandb/
.pytest_cache/
